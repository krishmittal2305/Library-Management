@model LibraryManagement.MVC.Models.Book

@{
    ViewData["Title"] = "Book Details";
}

<div class="page-header">
    <div class="container">
        <h1><i class="bi bi-info-circle me-2"></i>Book Details</h1>
        <p>Information about the book.</p>
    </div>
</div>

<main class="container page-wrapper">
    <div class="card shadow-sm col-md-8 mx-auto">
        <div class="card-body p-4">
            <h4 class="card-title text-primary fw-bold mb-4">@Model.Title</h4>
            
            <div class="row">
                @if (!string.IsNullOrEmpty(Model.Thumbnail))
                {
                    <div class="col-sm-3 order-sm-2 text-center mb-3">
                        <img src="@Model.Thumbnail" alt="Cover Image" class="img-fluid rounded shadow-sm" style="max-height: 250px;" />
                    </div>
                }
                
                <div class="col-sm-@(string.IsNullOrEmpty(Model.Thumbnail) ? "12" : "9") order-sm-1">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Author)</dt>
                        <dd class="col-sm-8 fw-bold">@Html.DisplayFor(model => model.Author)</dd>

                        <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.ISBN)</dt>
                        <dd class="col-sm-8">@(Model.ISBN ?? "N/A")</dd>

                        <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Publisher)</dt>
                        <dd class="col-sm-8">@(Model.Publisher ?? "Unknown")</dd>

                        <dt class="col-sm-4 text-muted">Published</dt>
                        <dd class="col-sm-8">@(Model.PublishedDate?.ToString("MMMM dd, yyyy") ?? "Unknown")</dd>

                        <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Category)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Category)</dd>

                        <dt class="col-sm-4 text-muted">Pages / Lang</dt>
                        <dd class="col-sm-8">@(Model.PageCount?.ToString() ?? "?") p. / @(Model.Language ?? "?")</dd>

                        <dt class="col-sm-4 text-muted">Rating</dt>
                        <dd class="col-sm-8">
                            @if (Model.AverageRating.HasValue)
                            {
                                <span class="text-warning"><i class="bi bi-star-fill"></i> @Model.AverageRating</span> <span class="text-muted small">(@Model.RatingsCount reviews)</span>
                            }
                            else
                            {
                                <span class="text-muted">No ratings</span>
                            }
                        </dd>

                        <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.TotalCopies)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.TotalCopies)</dd>

                        <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.AvailableCopies)</dt>
                        <dd class="col-sm-8">
                            @if (Model.AvailableCopies > 0)
                            {
                                <span class="badge bg-success">@Model.AvailableCopies Available</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Out of Stock</span>
                            }
                        </dd>
                    </dl>
                </div>
                
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div class="col-12 order-sm-3 mt-4 pt-3 border-top">
                        <h6 class="text-muted">Description</h6>
                        <p class="mb-0" style="white-space: pre-wrap;">@Model.Description</p>
                    </div>
                }
            </div>
        </div>
        <div class="card-footer bg-white p-4 d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Back to List</a>
            <div>
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning"><i class="bi bi-pencil"></i> Edit</a>
                <a asp-controller="Borrow" asp-action="Create" class="btn btn-primary"><i class="bi bi-bookmark-plus"></i> Issue Book</a>
            </div>
        </div>
    </div>
</main>
