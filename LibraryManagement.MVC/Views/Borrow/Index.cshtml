@model LibraryManagement.MVC.ViewModels.BorrowIndexViewModel

@{
    ViewData["Title"] = "Borrow History";
}

<div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2rem;">
    <div>
        <h1 style="font-size: 2rem; margin-bottom: 0.5rem; letter-spacing: -0.03em;">Borrow History</h1>
        <p style="color: var(--text-secondary); font-size: 1rem; margin-bottom: 0;">View all past and current borrowing records.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i data-lucide="plus" style="width: 18px; margin-right: 0.5rem;"></i> Issue Item
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.2); color: #10B981; padding: 1rem; border-radius: var(--radius-md); margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
        <i data-lucide="check-circle" style="width: 18px;"></i> @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div style="background: rgba(220, 38, 38, 0.1); border: 1px solid rgba(220, 38, 38, 0.2); color: #DC2626; padding: 1rem; border-radius: var(--radius-md); margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
        <i data-lucide="alert-triangle" style="width: 18px;"></i> @TempData["ErrorMessage"]
    </div>
}

<div class="card animate-fade-in stagger-1" style="padding: 0; overflow: hidden;">
    <div style="padding: 1.5rem; border-bottom: 1px solid var(--border-color); background: var(--bg-color);">
        <form method="get" asp-action="Index" style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
            <div style="position: relative; flex: 2; min-width: 250px;">
                <i data-lucide="search" style="position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); color: var(--text-secondary); width: 18px;"></i>
                <input type="text" name="searchQuery" value="@Model.SearchQuery" class="form-control" placeholder="Search by student or item title..." style="padding-left: 2.5rem; background: var(--card-bg);" />
            </div>
            <div style="flex: 1; min-width: 200px;">
                <select name="filterStatus" class="form-control" style="background: var(--card-bg); cursor: pointer;">
                    <option value="all" selected="@(Model.FilterStatus == "all" || string.IsNullOrEmpty(Model.FilterStatus))">All Records</option>
                    <option value="active" selected="@(Model.FilterStatus == "active")">Currently Borrowed</option>
                    <option value="returned" selected="@(Model.FilterStatus == "returned")">Returned</option>
                </select>
            </div>
            <button type="submit" class="btn btn-secondary">Search</button>
        </form>
    </div>

    <div class="table-responsive" style="border: none; border-radius: 0;">
        <table class="table" style="margin: 0;">
            <thead>
                <tr>
                    <th style="width: 50px;">#</th>
                    <th>Student</th>
                    <th>Item Borrowed</th>
                    <th>Borrow Date</th>
                    <th>Status</th>
                    <th style="text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.BorrowRecords.Any())
                {
                    <tr>
                        <td colspan="6" style="text-align: center; color: var(--text-secondary); padding: 3rem;">No borrow records found matching your criteria.</td>
                    </tr>
                }
                else
                {
                    foreach (var record in Model.BorrowRecords)
                    {
                        var itemName = record.Book != null ? record.Book.Title : (record.Publication != null ? record.Publication.Title : "Unknown Item");
                        var itemType = record.Book != null ? "Book" : (record.Publication != null ? record.Publication.Type.ToString() : "");
                        
                        <tr>
                            <td style="color: var(--text-secondary); font-weight: 500;">@record.Id</td>
                            <td>
                                <div style="font-weight: 600; color: var(--text-primary);">@record.Student?.Name</div>
                                <div style="color: var(--text-secondary); font-size: 0.875rem;">@record.Student?.EnrollmentNo</div>
                            </td>
                            <td>
                                <div style="font-weight: 600; color: var(--text-primary);">@itemName</div>
                                <span class="badge" style="background: var(--bg-color); border: 1px solid var(--border-color); color: var(--text-secondary); margin-top: 0.25rem;">@itemType</span>
                            </td>
                            <td>
                                <div style="font-size: 0.875rem; color: var(--text-secondary);"><span style="display: inline-block; width: 30px;">Out:</span> <span style="color: var(--text-primary);">@record.BorrowDate.ToShortDateString()</span></div>
                                <div style="font-size: 0.875rem; color: var(--text-secondary);"><span style="display: inline-block; width: 30px;">Due:</span> <span style="color: var(--text-primary);">@record.DueDate.ToShortDateString()</span></div>
                            </td>
                            <td>
                                @if (record.ReturnDate.HasValue)
                                {
                                    <span class="badge badge-success">Returned @record.ReturnDate.Value.ToShortDateString()</span>
                                }
                                else if (DateTime.Today > record.DueDate)
                                {
                                    <span class="badge badge-danger">Overdue</span>
                                }
                                else
                                {
                                    <span class="badge badge-warning">Active</span>
                                }
                            </td>
                            <td style="text-align: right; vertical-align: middle;">
                                @if (!record.ReturnDate.HasValue)
                                {
                                    <form asp-action="Return" asp-route-id="@record.Id" method="post" style="display: flex; gap: 0.5rem; justify-content: flex-end; align-items: center;">
                                        <select name="returnedByLibrarianId" class="form-control" required asp-items="Model.LibrariansList" style="width: auto; padding: 0.375rem 2rem 0.375rem 0.75rem; font-size: 0.875rem; height: auto;">
                                            <option value="">-- Librarian --</option>
                                        </select>
                                        <button type="submit" class="btn btn-secondary" style="padding: 0.375rem 0.75rem; font-size: 0.875rem;" onclick="return confirm('Confirm return for this item?');">
                                            Return
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span style="color: var(--text-secondary); font-size: 0.875rem; font-style: italic;">Completed</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="pagination">
            <span style="color: var(--text-secondary); font-size: 0.875rem;">Page @Model.CurrentPage of @Model.TotalPages</span>
            <div style="display: flex; gap: 0.5rem;">
                @if (Model.CurrentPage > 1)
                {
                    <a class="page-btn" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-searchQuery="@Model.SearchQuery" asp-route-filterStatus="@Model.FilterStatus">
                        <i data-lucide="chevron-left" style="width: 16px;"></i>
                    </a>
                }
                
                @{ int _mP = 5; int _sP = Math.Max(1, Model.CurrentPage - _mP/2); int _eP = Math.Min(Model.TotalPages, _sP + _mP - 1); if(_eP - _sP + 1 < _mP){_sP = Math.Max(1, _eP - _mP + 1);} }
                @for (int i = _sP; i <= _eP; i++)
                {
                    <a class="page-btn @(i == Model.CurrentPage ? "active" : "")" asp-action="Index" asp-route-page="@i" asp-route-searchQuery="@Model.SearchQuery" asp-route-filterStatus="@Model.FilterStatus">@i</a>
                }

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a class="page-btn" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-searchQuery="@Model.SearchQuery" asp-route-filterStatus="@Model.FilterStatus">
                        <i data-lucide="chevron-right" style="width: 16px;"></i>
                    </a>
                }
            </div>
        </div>
    }
</div>
