@model LibraryManagement.MVC.ViewModels.BorrowFormViewModel

@{
    ViewData["Title"] = "Issue Item";
}

<div class="page-header">
    <div class="container">
        <h1><i class="bi bi-arrow-left-right me-2"></i>Issue Item</h1>
        <p>Borrow a book, magazine, or newspaper to a student.</p>
    </div>
</div>

<main class="container page-wrapper">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-primary text-decoration-none">Borrow History</a></li>
            <li class="breadcrumb-item active" aria-current="page">Issue Item</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm border">
                <div class="card-header bg-white pt-3 pb-2">
                    <span class="fw-bold"><i class="bi bi-box-arrow-right text-primary fs-5 me-2"></i>New Borrow Record</span>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="All" class="alert alert-danger mb-3"></div>
                        
                        <div class="mb-4">
                            <label asp-for="StudentId" class="form-label fw-bold">Student <span class="text-danger">*</span></label>
                            <select asp-for="StudentId" class="form-select" asp-items="Model.StudentsList">
                                <option value="">-- Select a Student --</option>
                            </select>
                            <span asp-validation-for="StudentId" class="text-danger small"></span>
                        </div>
                        
                        <div class="mb-4 p-3 border rounded bg-light">
                            <label class="form-label fw-bold text-dark">Select Item to Borrow <span class="text-danger">*</span></label>
                            <p class="small text-muted mb-3">Choose either a Book OR a Publication. You cannot select both.</p>
                            
                            <div class="mb-3">
                                <label asp-for="BookId" class="form-label fw-bold text-secondary">Book</label>
                                <select asp-for="BookId" class="form-select" asp-items="Model.AvailableBooksList">
                                    <option value="">-- No Book Selected --</option>
                                </select>
                            </div>
                            
                            <div class="mb-2 text-center text-muted fw-bold">OR</div>

                            <div>
                                <label asp-for="PublicationId" class="form-label fw-bold text-secondary">Magazine / Newspaper</label>
                                <select asp-for="PublicationId" class="form-select" asp-items="Model.AvailablePublicationsList">
                                    <option value="">-- No Publication Selected --</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="BorrowDate" class="form-label fw-bold">Borrow Date <span class="text-danger">*</span></label>
                            <input asp-for="BorrowDate" class="form-control" required />
                            <span asp-validation-for="BorrowDate" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="DueDate" class="form-label fw-bold">Due Date <span class="text-danger">*</span></label>
                            <input asp-for="DueDate" class="form-control" required />
                            <span asp-validation-for="DueDate" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="LibrarianId" class="form-label fw-bold">Issuing Librarian <span class="text-danger">*</span></label>
                            <select asp-for="LibrarianId" class="form-select" asp-items="Model.LibrariansList">
                                <option value="">-- Select Issuing Librarian --</option>
                            </select>
                            <span asp-validation-for="LibrarianId" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2 justify-content-end mt-5">
                            <a asp-action="Index" class="btn btn-light border px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-save me-1"></i> Issue Item
                            </button>
                        </div>
                    </form>
                </div>
            </div>
    </div>
  </div>
</main>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
