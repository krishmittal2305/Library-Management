@model LibraryManagement.MVC.Models.Magazine

@{
    ViewData["Title"] = "Delete Magazine";
}

<div class="page-header">
    <div class="container">
        <h1><i class="bi bi-exclamation-triangle text-danger me-2"></i>Delete Magazine</h1>
        <p>Confirm the removal of this magazine.</p>
    </div>
</div>

<main class="container page-wrapper">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="alert alert-danger d-flex align-items-center p-4 mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill flex-shrink-0 fs-2 me-3"></i>
                <div>
                    <h4 class="alert-heading fw-bold mb-1">Are you absolutely sure?</h4>
                    <p class="mb-0">This action cannot be undone. This will permanently delete the magazine <strong>@Model.Title</strong> from the catalog.</p>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-md-5">
                    <div class="row">
                        <div class="col-md-8">
                            <h3 class="fw-bold mb-1">@Model.Title</h3>
                            <p class="text-secondary fs-5 mb-4">By @Model.Publisher</p>
                            
                            <table class="table table-borderless">
                                <tbody>
                                    <tr>
                                        <th class="ps-0 w-25 text-muted">Category</th>
                                        <td class="fw-semibold">@Model.Category</td>
                                    </tr>
                                    <tr>
                                        <th class="ps-0 text-muted">Language</th>
                                        <td class="fw-semibold">@Model.Language</td>
                                    </tr>
                                    <tr>
                                        <th class="ps-0 text-muted">Published</th>
                                        <td class="fw-semibold">@Model.PublishedDate.ToString("MMMM dd, yyyy")</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <form asp-action="Delete" class="mt-4 pt-4 border-top">
                        <input type="hidden" asp-for="MagazineId" />
                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-light px-4">Cancel</a>
                            <button type="submit" class="btn btn-danger px-4 fw-bold">
                                <i class="bi bi-trash3 me-1"></i> Yes, Delete Magazine
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</main>
