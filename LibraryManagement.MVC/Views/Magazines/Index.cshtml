@model LibraryManagement.MVC.ViewModels.MagazineIndexViewModel

@{
    ViewData["Title"] = "Magazines";
}

<div class="page-header">
    <div class="container">
        <h1><i class="bi bi-journal-text me-2"></i>Magazines</h1>
        <p>Manage library magazines.</p>
    </div>
</div>

<main class="container page-wrapper">
    <!-- Toolbar -->
    <div class="card mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-3 align-items-center">
                <div class="col-md-9">
                    <input type="text" name="searchQuery" value="@Model.SearchQuery" class="form-control" placeholder="Search by Title, Publisher, Category, or Language..." />
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-secondary flex-grow-1"><i class="bi bi-search"></i> Search</button>
                    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add New</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Magazines Table -->
    <div class="table-responsive table-wrapper border shadow-sm mb-5">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Title</th>
                    <th scope="col">Publisher</th>
                    <th scope="col">Category</th>
                    <th scope="col">Language</th>
                    <th scope="col">Date</th>
                    <th scope="col">Status</th>
                    <th style="text-align: right;">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Magazines.Any())
                {
                    <tr>
                        <td colspan="8" class="table-no-results py-5 text-center">
                            <i class="bi bi-search fs-2 d-block mb-3 text-muted"></i>
                            <p class="mb-0 fw-bold">No magazines found matching your criteria.</p>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model.Magazines)
                    {
                        <tr>
                            <td class="text-muted fw-bold">@item.MagazineId</td>
                            <td class="fw-bold text-dark">@item.Title</td>
                            <td>@item.Publisher</td>
                            <td><span class="badge bg-secondary text-light">@item.Category</span></td>
                            <td>@item.Language</td>
                            <td>@item.PublishedDate.ToString("MMM yyyy")</td>
                            <td>
                                @if(item.Availability)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">Available</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1">Unavailable</span>
                                }
                            </td>
                            <td style="text-align: right;">
                                <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
                                    <a asp-action="Details" asp-route-id="@item.MagazineId" class="btn btn-ghost" style="padding: 0.5rem;" title="Details">
                                        <i data-lucide="eye" style="width: 18px; color: var(--text-secondary);"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.MagazineId" class="btn btn-ghost" style="padding: 0.5rem;" title="Edit">
                                        <i data-lucide="edit-2" style="width: 18px;"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.MagazineId" class="btn btn-ghost" style="padding: 0.5rem;" title="Delete">
                                        <i data-lucide="trash-2" style="width: 18px; color: #DC2626;"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4 d-flex justify-content-between align-items-center">
            <span class="text-muted small">Page @Model.CurrentPage of @Model.TotalPages</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" 
                       asp-route-page="@(Model.CurrentPage - 1)" 
                       asp-route-searchQuery="@Model.SearchQuery"><i class="bi bi-chevron-left"></i></a>
                </li>
                
                @{ int _mP = 10; int _sP = Math.Max(1, Model.CurrentPage - _mP/2); int _eP = Math.Min(Model.TotalPages, _sP + _mP - 1); if(_eP - _sP + 1 < _mP){_sP = Math.Max(1, _eP - _mP + 1);} }
                        @for (int i = _sP; i <= _eP; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-page="@i" 
                           asp-route-searchQuery="@Model.SearchQuery">@i</a>
                    </li>
                }

                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" 
                       asp-route-page="@(Model.CurrentPage + 1)" 
                       asp-route-searchQuery="@Model.SearchQuery"><i class="bi bi-chevron-right"></i></a>
                </li>
            </ul>
        </nav>
    }
</main>
