@model LibraryManagement.MVC.Models.Magazine

@{
    ViewData["Title"] = "Edit Magazine";
}

<div class="page-header">
    <div class="container">
        <h1><i class="bi bi-pencil-square me-2"></i>Edit Magazine</h1>
        <p>Update existing magazine details.</p>
    </div>
</div>

<main class="container page-wrapper">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom p-4">
                    <h5 class="mb-0 text-success fw-bold">Edit Magazine: @Model.Title</h5>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="MagazineId" />

                        <div class="row g-4">
                            <!-- Title -->
                            <div class="col-md-12">
                                <label asp-for="Title" class="form-label fw-semibold">Title <span class="text-danger">*</span></label>
                                <input asp-for="Title" class="form-control form-control-lg" required />
                                <span asp-validation-for="Title" class="text-danger small"></span>
                            </div>

                            <!-- Publisher -->
                            <div class="col-md-6">
                                <label asp-for="Publisher" class="form-label fw-semibold">Publisher <span class="text-danger">*</span></label>
                                <input asp-for="Publisher" class="form-control" required />
                                <span asp-validation-for="Publisher" class="text-danger small"></span>
                            </div>

                            <!-- PublishedDate -->
                            <div class="col-md-6">
                                <label asp-for="PublishedDate" class="form-label fw-semibold">Published Date <span class="text-danger">*</span></label>
                                <input asp-for="PublishedDate" class="form-control" type="date" required />
                                <span asp-validation-for="PublishedDate" class="text-danger small"></span>
                            </div>

                            <!-- Category -->
                            <div class="col-md-6">
                                <label asp-for="Category" class="form-label fw-semibold">Category <span class="text-danger">*</span></label>
                                <input asp-for="Category" class="form-control" required />
                                <span asp-validation-for="Category" class="text-danger small"></span>
                            </div>

                            <!-- Language -->
                            <div class="col-md-6">
                                <label asp-for="Language" class="form-label fw-semibold">Language <span class="text-danger">*</span></label>
                                <input asp-for="Language" class="form-control" required />
                                <span asp-validation-for="Language" class="text-danger small"></span>
                            </div>

                            <!-- Availability -->
                            <div class="col-md-12">
                                <div class="form-check form-switch mt-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Availability">
                                    <label class="form-check-label" asp-for="Availability">Is currently available?</label>
                                </div>
                            </div>

                            <!-- Description -->
                            <div class="col-12">
                                <label asp-for="Description" class="form-label fw-semibold">Description</label>
                                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>

                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-5 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-light px-4">Cancel</a>
                            <button type="submit" class="btn btn-success px-4 fw-semibold">
                                <i class="bi bi-save me-1"></i> Update Magazine
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
