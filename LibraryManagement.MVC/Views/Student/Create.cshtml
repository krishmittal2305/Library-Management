@model LibraryManagement.MVC.Models.Student

@{
    ViewData["Title"] = "Add Student";
}

<div class="page-header">
    <div class="container">
        <h1><i class="bi bi-person-plus me-2"></i>Add Student</h1>
        <p>Register a new student in the system.</p>
    </div>
</div>

<main class="container page-wrapper">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header d-flex align-items-center gap-2">
                    <i class="bi bi-person-plus text-primary"></i>
                    <span class="fw-bold">Student Registration</span>
                </div>
                <div class="card-body p-4 p-lg-5">
                    <form asp-action="Create" data-loading="Saving student…">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4 py-2 small fw-bold"></div>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <label asp-for="EnrollmentNo" class="form-label"></label>
                                <input asp-for="EnrollmentNo" class="form-control" placeholder="e.g. ENR001" />
                                <span asp-validation-for="EnrollmentNo" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label"></label>
                                <input asp-for="Name" class="form-control" placeholder="Full Name" />
                                <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" placeholder="email@example.com" />
                                <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label"></label>
                                <input asp-for="Phone" class="form-control" placeholder="10-digit phone" />
                                <span asp-validation-for="Phone" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Department" class="form-label"></label>
                                <input asp-for="Department" class="form-control" placeholder="e.g. Computer Science" />
                                <span asp-validation-for="Department" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Semester" class="form-label"></label>
                                <input asp-for="Semester" class="form-control" type="number" min="1" max="8" />
                                <span asp-validation-for="Semester" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-5 pt-4 border-top">
                            <a asp-action="Index" class="btn btn-secondary px-4">
                                <i class="bi bi-arrow-left me-1"></i> Back
                            </a>
                            <button type="submit" class="btn btn-primary px-5 fw-bold">
                                <i class="bi bi-save me-1"></i> Register Student
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
