@model LibraryManagement.MVC.Models.Student

@{
    ViewData["Title"] = "Student Details";
}

<div class="page-header">
    <div class="container">
        <h1><i class="bi bi-person-lines-fill me-2"></i>Student Details</h1>
        <p>Information about the student.</p>
    </div>
</div>

<main class="container-fluid px-4 pb-5">
    <!-- Top Profile Card (Full Width) -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4 p-md-5">
            <div class="row align-items-center">
                <!-- Left: Profile Image -->
                <div class="col-md-auto text-center mb-4 mb-md-0 me-md-4">
                    <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(Model.Name)&background=random&color=fff&size=180" alt="@Model.Name" class="rounded-circle shadow-sm" style="width: 180px; height: 180px; border: 5px solid #f8fafc;" />
                </div>
                
                <!-- Right: Student Details -->
                <div class="col-md">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center border-bottom pb-3 mb-4">
                        <div>
                            <h2 class="fw-bold text-dark mb-1">@Model.Name</h2>
                            <p class="text-primary fw-bold mb-0 fs-5">@Model.EnrollmentNo</p>
                        </div>
                        <div class="mt-3 mt-md-0 d-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary rounded-pill px-4"><i class="bi bi-pencil me-2"></i>Edit Profile</a>
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4"><i class="bi bi-arrow-left me-2"></i>Back</a>
                        </div>
                    </div>
                    
                    <div class="row g-4">
                        <div class="col-sm-6 col-lg-3">
                            <label class="text-muted small fw-bold text-uppercase mb-1"><i class="bi bi-envelope me-1"></i>Email Address</label>
                            <p class="mb-0 fw-500 fs-6">@(string.IsNullOrEmpty(Model.Email) ? "N/A" : Model.Email)</p>
                        </div>
                        <div class="col-sm-6 col-lg-3">
                            <label class="text-muted small fw-bold text-uppercase mb-1"><i class="bi bi-telephone me-1"></i>Phone Number</label>
                            <p class="mb-0 fw-500 fs-6">@(string.IsNullOrEmpty(Model.Phone) ? "N/A" : Model.Phone)</p>
                        </div>
                        <div class="col-sm-6 col-lg-3">
                            <label class="text-muted small fw-bold text-uppercase mb-1"><i class="bi bi-building me-1"></i>Department</label>
                            <p class="mb-0 fw-500 fs-6">@Model.Department</p>
                        </div>
                        <div class="col-sm-6 col-lg-3">
                            <label class="text-muted small fw-bold text-uppercase mb-1"><i class="bi bi-mortarboard me-1"></i>Semester</label>
                            <p class="mb-0 fw-500 fs-6">Semester @Model.Semester</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Borrow History -->
    @inject LibraryManagement.MVC.Data.LibraryDbContext DbContext
    @using Microsoft.EntityFrameworkCore
    @{
        var borrowRecords = DbContext.BorrowRecords
            .Include(b => b.Book)
            .Include(b => b.Publication)
            .Where(b => b.StudentId == Model.Id)
            .OrderByDescending(b => b.BorrowDate)
            .ToList();
    }
    
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white pt-4 pb-3 border-bottom-0">
            <h4 class="fw-bold m-0"><i class="bi bi-clock-history text-danger me-2"></i>Borrowing History</h4>
        </div>
        <div class="card-body p-0">
            @if (borrowRecords.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Item Title</th>
                                <th>Borrow Date</th>
                                <th>Due Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var record in borrowRecords)
                            {
                                var itemName = record.Book != null ? record.Book.Title : (record.Publication != null ? record.Publication.Title : "Unknown Item");
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">@itemName</td>
                                    <td class="text-secondary">@record.BorrowDate.ToShortDateString()</td>
                                    <td class="text-secondary">@record.DueDate.ToShortDateString()</td>
                                    <td>
                                        @if (record.ReturnDate.HasValue)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">Returned on @record.ReturnDate.Value.ToShortDateString()</span>
                                        }
                                        else if (DateTime.Today > record.DueDate)
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1">Overdue</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2 py-1">Active</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-5 text-center text-muted">
                    <i class="bi bi-journal-x fs-1 mb-3 text-secondary opacity-50"></i>
                    <p class="mb-0 fs-5">No borrowing history for this student yet.</p>
                </div>
            }
        </div>
    </div>
</main>
