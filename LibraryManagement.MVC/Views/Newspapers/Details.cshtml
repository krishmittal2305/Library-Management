@model LibraryManagement.MVC.Models.Newspaper

@{
    ViewData["Title"] = "Newspaper Details";
}

<div class="page-header">
    <div class="container">
        <h1><i class="bi bi-eye me-2"></i>Newspaper Details</h1>
        <p>View complete information about this newspaper.</p>
    </div>
</div>

<main class="container page-wrapper">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom p-4 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-primary fw-bold">Newspaper Details</h5>
                    @if(Model.Availability)
                    {
                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2">Available</span>
                    }
                    else
                    {
                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-2">Unavailable</span>
                    }
                </div>
                <div class="card-body p-4 p-md-5">
                    <div class="row mb-4">
                        <div class="col-md-12 text-center mb-4">
                            <div class="display-1 text-muted mb-3"><i class="bi bi-newspaper"></i></div>
                            <h2 class="fw-bold">@Model.Title</h2>
                            <p class="text-secondary fs-5">@Model.Publisher</p>
                        </div>
                    </div>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 h-100">
                                <span class="d-block text-muted small text-uppercase mb-1 fw-bold">Edition</span>
                                <span class="fs-5 fw-semibold">@(string.IsNullOrEmpty(Model.Edition) ? "N/A" : Model.Edition)</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 h-100">
                                <span class="d-block text-muted small text-uppercase mb-1 fw-bold">Language</span>
                                <span class="fs-5 fw-semibold">@Model.Language</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 h-100">
                                <span class="d-block text-muted small text-uppercase mb-1 fw-bold">Published Date</span>
                                <span class="fs-5 fw-semibold">@Model.PublishedDate.ToString("MMMM dd, yyyy")</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 h-100">
                                <span class="d-block text-muted small text-uppercase mb-1 fw-bold">Newspaper ID</span>
                                <span class="fs-5 fw-semibold">@Model.NewspaperId</span>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="p-3 border rounded-3 bg-white h-100">
                                <span class="d-block text-muted small text-uppercase mb-2 fw-bold">Description</span>
                                <p class="mb-0">@(string.IsNullOrEmpty(Model.Description) ? "No description provided." : Model.Description)</p>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-5 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light px-4">Back to List</a>
                        <div>
                            <a asp-action="Edit" asp-route-id="@Model.NewspaperId" class="btn btn-success px-4 me-2">
                                <i class="bi bi-pencil me-1"></i> Edit
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
