@model LibraryManagement.MVC.Models.Newspaper

@{
    ViewData["Title"] = "Add Newspaper";
}

<div class="page-header">
    <div class="container">
        <h1><i class="bi bi-plus-circle me-2"></i>Add Newspaper</h1>
        <p>Register a new newspaper issue into the library catalog.</p>
    </div>
</div>

<main class="container page-wrapper">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom p-4">
                    <h5 class="mb-0 text-primary fw-bold">Newspaper Details</h5>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-4">
                            <!-- Title -->
                            <div class="col-md-12">
                                <label asp-for="Title" class="form-label fw-semibold">Title <span class="text-danger">*</span></label>
                                <input asp-for="Title" class="form-control form-control-lg" placeholder="e.g. The New York Times" required />
                                <span asp-validation-for="Title" class="text-danger small"></span>
                            </div>

                            <!-- Publisher -->
                            <div class="col-md-6">
                                <label asp-for="Publisher" class="form-label fw-semibold">Publisher <span class="text-danger">*</span></label>
                                <input asp-for="Publisher" class="form-control" placeholder="e.g. NYT Company" required />
                                <span asp-validation-for="Publisher" class="text-danger small"></span>
                            </div>

                            <!-- PublishedDate -->
                            <div class="col-md-6">
                                <label asp-for="PublishedDate" class="form-label fw-semibold">Published Date <span class="text-danger">*</span></label>
                                <input asp-for="PublishedDate" class="form-control" type="date" required />
                                <span asp-validation-for="PublishedDate" class="text-danger small"></span>
                            </div>

                            <!-- Edition -->
                            <div class="col-md-6">
                                <label asp-for="Edition" class="form-label fw-semibold">Edition</label>
                                <input asp-for="Edition" class="form-control" placeholder="e.g. Morning, Sunday Special" />
                                <span asp-validation-for="Edition" class="text-danger small"></span>
                            </div>

                            <!-- Language -->
                            <div class="col-md-6">
                                <label asp-for="Language" class="form-label fw-semibold">Language <span class="text-danger">*</span></label>
                                <input asp-for="Language" class="form-control" placeholder="e.g. English" required />
                                <span asp-validation-for="Language" class="text-danger small"></span>
                            </div>

                            <!-- Availability -->
                            <div class="col-md-12">
                                <div class="form-check form-switch mt-2">
                                    <input class="form-check-input" type="checkbox" asp-for="Availability" checked>
                                    <label class="form-check-label" asp-for="Availability">Is currently available?</label>
                                </div>
                            </div>

                            <!-- Description -->
                            <div class="col-12">
                                <label asp-for="Description" class="form-label fw-semibold">Description</label>
                                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Additional details..."></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>

                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-5 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-light px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4 fw-semibold">
                                <i class="bi bi-check2-circle me-1"></i> Save Newspaper
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
