@model LibraryManagement.MVC.Models.Librarian

@{
    ViewData["Title"] = "Librarian Details";
}

<div class="page-header">
    <div class="container">
        <h1><i class="bi bi-person-lines-fill me-2"></i>Librarian Details</h1>
        <p>Information about the librarian.</p>
    </div>
</div>

<main class="container page-wrapper">
    <div class="card shadow-sm col-md-8 mx-auto">
        <div class="card-body p-4">
            <h4 class="card-title text-primary fw-bold mb-4">@Model.Name</h4>
            
            <dl class="row mb-0">
                <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.EmployeeId)</dt>
                <dd class="col-sm-8 fw-bold">@Html.DisplayFor(model => model.EmployeeId)</dd>

                <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Email)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Email)</dd>

                <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Phone)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Phone)</dd>

                <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Shift)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Shift)</dd>
            </dl>
        </div>
        </div>
    </div>

    @inject LibraryManagement.MVC.Data.LibraryDbContext DbContext
    @using Microsoft.EntityFrameworkCore
    @{
        var transactions = DbContext.BorrowRecords
            .Include(b => b.Student)
            .Include(b => b.Book)
            .Include(b => b.Publication)
            .Where(b => b.IssuedByLibrarianId == Model.Id || b.ReturnedByLibrarianId == Model.Id)
            .OrderByDescending(b => b.BorrowDate)
            .ToList();
    }

    <div class="card shadow-sm col-md-8 mx-auto mt-4">
        <div class="card-header bg-white pt-3 pb-2">
            <span class="fw-bold"><i class="bi bi-card-list text-primary fs-5 me-2"></i>Transaction History</span>
        </div>
        <div class="card-body p-0">
            @if (transactions.Any())
            {
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Action</th>
                            <th>Student</th>
                            <th>Item</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in transactions)
                        {
                            var itemName = record.Book != null ? record.Book.Title : (record.Publication != null ? record.Publication.Title : "Unknown Item");
                            
                            @if (record.IssuedByLibrarianId == Model.Id)
                            {
                                <tr>
                                    <td class="ps-4"><span class="badge bg-primary">Issued</span></td>
                                    <td>@record.Student?.Name</td>
                                    <td class="text-secondary fw-bold">@itemName</td>
                                    <td>@record.BorrowDate.ToShortDateString()</td>
                                </tr>
                            }
                            @if (record.ReturnedByLibrarianId == Model.Id && record.ReturnDate.HasValue)
                            {
                                <tr>
                                    <td class="ps-4"><span class="badge bg-success">Received</span></td>
                                    <td>@record.Student?.Name</td>
                                    <td class="text-secondary fw-bold">@itemName</td>
                                    <td>@record.ReturnDate.Value.ToShortDateString()</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="p-4 text-center text-muted">
                    No transactions handled by this librarian.
                </div>
            }
        </div>
    </div>
</main>
