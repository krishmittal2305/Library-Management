@model LibraryManagement.MVC.Models.Fine

@{
    ViewData["Title"] = "Edit Fine";
}

<div class="page-header">
    <div class="container">
        <h1><i class="bi bi-pencil-square me-2"></i>Edit Fine</h1>
        <p>Update fine details.</p>
    </div>
</div>

<main class="container page-wrapper">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom p-4">
                    <h5 class="mb-0 text-success fw-bold">Edit Fine ID: @Model.FineId</h5>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="FineId" />

                        <div class="row g-4">
                            <!-- Student -->
                            <div class="col-md-6">
                                <label asp-for="StudentId" class="form-label fw-semibold">Student <span class="text-danger">*</span></label>
                                <select asp-for="StudentId" class="form-select" asp-items="ViewBag.StudentId" required></select>
                                <span asp-validation-for="StudentId" class="text-danger small"></span>
                            </div>

                            <!-- Borrow Record -->
                            <div class="col-md-6">
                                <label asp-for="BorrowId" class="form-label fw-semibold">Borrow Record ID <span class="text-danger">*</span></label>
                                <select asp-for="BorrowId" class="form-select" asp-items="ViewBag.BorrowId" required></select>
                                <span asp-validation-for="BorrowId" class="text-danger small"></span>
                            </div>

                            <!-- Amount -->
                            <div class="col-md-6">
                                <label asp-for="Amount" class="form-label fw-semibold">Amount (₹) <span class="text-danger">*</span></label>
                                <input asp-for="Amount" class="form-control" type="number" step="0.01" required />
                                <span asp-validation-for="Amount" class="text-danger small"></span>
                            </div>

                            <!-- Reason -->
                            <div class="col-md-6">
                                <label asp-for="Reason" class="form-label fw-semibold">Reason</label>
                                <input asp-for="Reason" class="form-control" />
                                <span asp-validation-for="Reason" class="text-danger small"></span>
                            </div>

                            <!-- Generated Date -->
                            <div class="col-md-6">
                                <label asp-for="GeneratedDate" class="form-label fw-semibold">Generated Date <span class="text-danger">*</span></label>
                                <input asp-for="GeneratedDate" class="form-control" type="date" required />
                                <span asp-validation-for="GeneratedDate" class="text-danger small"></span>
                            </div>

                            <!-- Status -->
                            <div class="col-md-6">
                                <label asp-for="Status" class="form-label fw-semibold">Status <span class="text-danger">*</span></label>
                                <select asp-for="Status" class="form-select" required>
                                    <option value="Pending">Pending</option>
                                    <option value="Paid">Paid</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>

                            <!-- Paid Date -->
                            <div class="col-md-6">
                                <label asp-for="PaidDate" class="form-label fw-semibold">Paid Date</label>
                                <input asp-for="PaidDate" class="form-control" type="date" />
                                <span asp-validation-for="PaidDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-5 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-light px-4">Cancel</a>
                            <button type="submit" class="btn btn-success px-4 fw-semibold">
                                <i class="bi bi-save me-1"></i> Update Fine
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
