@model LibraryManagement.MVC.Models.Fine

@{
    ViewData["Title"] = "Delete Fine";
}

<div class="page-header">
    <div class="container">
        <h1><i class="bi bi-exclamation-triangle text-danger me-2"></i>Delete Fine</h1>
        <p>Confirm the removal of this fine record.</p>
    </div>
</div>

<main class="container page-wrapper">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="alert alert-danger d-flex align-items-center p-4 mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill flex-shrink-0 fs-2 me-3"></i>
                <div>
                    <h4 class="alert-heading fw-bold mb-1">Are you absolutely sure?</h4>
                    <p class="mb-0">This action cannot be undone. This will permanently delete fine <strong>#@Model.FineId</strong> for @Model.Student?.Name.</p>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-md-5">
                    <div class="row">
                        <div class="col-md-8">
                            <h3 class="fw-bold mb-1 text-danger">₹@Model.Amount.ToString("0.00")</h3>
                            <p class="text-secondary fs-5 mb-4">Student: @Model.Student?.Name</p>
                            
                            <table class="table table-borderless">
                                <tbody>
                                    <tr>
                                        <th class="ps-0 w-25 text-muted">Reason</th>
                                        <td class="fw-semibold">@Model.Reason</td>
                                    </tr>
                                    <tr>
                                        <th class="ps-0 text-muted">Status</th>
                                        <td class="fw-semibold">
                                            @if(Model.Status == "Paid") { <span class="text-success">Paid</span> } else { <span class="text-warning text-dark">Pending</span> }
                                        </td>
                                    </tr>
                                    <tr>
                                        <th class="ps-0 text-muted">Generated Date</th>
                                        <td class="fw-semibold">@Model.GeneratedDate.ToShortDateString()</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <form asp-action="Delete" class="mt-4 pt-4 border-top">
                        <input type="hidden" asp-for="FineId" />
                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-light px-4">Cancel</a>
                            <button type="submit" class="btn btn-danger px-4 fw-bold">
                                <i class="bi bi-trash3 me-1"></i> Yes, Delete Fine
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</main>
