@model LibraryManagement.MVC.Models.Fine

@{
    ViewData["Title"] = "Fine Details";
}

<div class="page-header">
    <div class="container">
        <h1><i class="bi bi-eye me-2"></i>Fine Details</h1>
        <p>View complete information about this fine.</p>
    </div>
</div>

<main class="container page-wrapper">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom p-4 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-primary fw-bold">Fine ID: @Model.FineId</h5>
                    @if(Model.Status == "Paid")
                    {
                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2">Paid</span>
                    }
                    else
                    {
                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-3 py-2 text-dark">Pending</span>
                    }
                </div>
                <div class="card-body p-4 p-md-5">
                    <div class="row mb-4">
                        <div class="col-md-12 text-center mb-4">
                            <div class="display-1 text-muted mb-3"><i class="bi bi-cash-stack"></i></div>
                            <h2 class="fw-bold text-danger">₹@Model.Amount.ToString("0.00")</h2>
                            <p class="text-secondary fs-5">@Model.Student?.Name</p>
                        </div>
                    </div>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 h-100">
                                <span class="d-block text-muted small text-uppercase mb-1 fw-bold">Borrow ID</span>
                                <span class="fs-5 fw-semibold">@Model.BorrowId</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 h-100">
                                <span class="d-block text-muted small text-uppercase mb-1 fw-bold">Generated Date</span>
                                <span class="fs-5 fw-semibold">@Model.GeneratedDate.ToShortDateString()</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 h-100">
                                <span class="d-block text-muted small text-uppercase mb-1 fw-bold">Paid Date</span>
                                <span class="fs-5 fw-semibold">@(Model.PaidDate?.ToShortDateString() ?? "N/A")</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 h-100">
                                <span class="d-block text-muted small text-uppercase mb-1 fw-bold">Student Enrollment</span>
                                <span class="fs-5 fw-semibold">@(Model.Student?.EnrollmentNo ?? "N/A")</span>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="p-3 border rounded-3 bg-white h-100">
                                <span class="d-block text-muted small text-uppercase mb-2 fw-bold">Reason</span>
                                <p class="mb-0 fs-5">@(string.IsNullOrEmpty(Model.Reason) ? "No reason specified." : Model.Reason)</p>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-5 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light px-4">Back to List</a>
                        <div>
                            @if(Model.Status == "Pending")
                            {
                                <form asp-action="MarkPaid" asp-route-id="@Model.FineId" method="post" style="display:inline;" class="me-2">
                                    <button type="submit" class="btn btn-success px-4 fw-bold">
                                        <i class="bi bi-currency-rupee"></i> Mark Paid
                                    </button>
                                </form>
                            }
                            <a asp-action="Edit" asp-route-id="@Model.FineId" class="btn btn-primary px-4">
                                <i class="bi bi-pencil me-1"></i> Edit
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
