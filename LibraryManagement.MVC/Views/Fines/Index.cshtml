@model LibraryManagement.MVC.ViewModels.FineIndexViewModel

@{
    ViewData["Title"] = "Fines";
}

<div class="page-header">
    <div class="container">
        <h1><i class="bi bi-cash-stack me-2"></i>Fine Management</h1>
        <p>View and manage late return fines.</p>
    </div>
</div>

<main class="container page-wrapper">
    <!-- Dashboard Cards for Fines -->
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 bg-danger text-white h-100">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="me-3">
                        <i class="bi bi-exclamation-circle-fill display-4 text-white opacity-75"></i>
                    </div>
                    <div>
                        <h6 class="text-uppercase fw-bold mb-1 opacity-75">Pending Fine</h6>
                        <h2 class="mb-0 fw-bold">₹@Model.TotalPendingFine.ToString("0.00")</h2>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm border-0 bg-success text-white h-100">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="me-3">
                        <i class="bi bi-check-circle-fill display-4 text-white opacity-75"></i>
                    </div>
                    <div>
                        <h6 class="text-uppercase fw-bold mb-1 opacity-75">Collected Fine</h6>
                        <h2 class="mb-0 fw-bold">₹@Model.TotalCollectedFine.ToString("0.00")</h2>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Toolbar -->
    <div class="card mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-3 align-items-center">
                <div class="col-md-6">
                    <input type="text" name="searchQuery" value="@Model.SearchQuery" class="form-control" placeholder="Search by student or book..." />
                </div>
                <div class="col-md-3">
                    <select name="filterStatus" class="form-select">
                        <option value="all" selected="@(Model.FilterStatus == "all" || string.IsNullOrEmpty(Model.FilterStatus))">All Fines</option>
                        <option value="Pending" selected="@(Model.FilterStatus == "Pending")">Pending</option>
                        <option value="Paid" selected="@(Model.FilterStatus == "Paid")">Paid</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-secondary flex-grow-1"><i class="bi bi-search"></i> Search</button>
                    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Fine</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Fine History Table -->
    <div class="table-responsive table-wrapper border shadow-sm mb-5">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Student</th>
                    <th scope="col">Reason</th>
                    <th scope="col">Generated Date</th>
                    <th scope="col">Amount</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Fines.Any())
                {
                    <tr>
                        <td colspan="7" class="table-no-results py-5 text-center">
                            <i class="bi bi-check2-circle fs-2 d-block mb-3 text-success"></i>
                            <p class="mb-0 fw-bold">No fines found matching your criteria.</p>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var fine in Model.Fines)
                    {
                        <tr>
                            <td class="text-muted fw-bold">@fine.FineId</td>
                            <td>
                                <div class="fw-bold text-dark">@fine.Student?.Name</div>
                                <small class="text-muted">Borrow ID: @fine.BorrowId</small>
                            </td>
                            <td class="text-secondary">@fine.Reason</td>
                            <td>@fine.GeneratedDate.ToShortDateString()</td>
                            <td><strong class="text-danger">₹@fine.Amount</strong></td>
                            <td>
                                @if (fine.Status == "Paid")
                                {
                                    <span class="badge bg-success">Paid</span>
                                    <br><small class="text-muted" style="font-size: 0.7em;">@fine.PaidDate?.ToShortDateString()</small>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    @if (fine.Status == "Pending")
                                    {
                                        <form asp-action="MarkPaid" asp-route-id="@fine.FineId" method="post" style="display:inline;">
                                            <button type="submit" class="btn btn-outline-success fw-bold me-1" title="Mark Paid">
                                                <i class="bi bi-currency-rupee"></i> Pay
                                            </button>
                                        </form>
                                    }
                                    <a asp-action="Edit" asp-route-id="@fine.FineId" class="btn btn-success" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@fine.FineId" class="btn btn-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4 d-flex justify-content-between align-items-center">
            <span class="text-muted small">Page @Model.CurrentPage of @Model.TotalPages</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" 
                       asp-route-page="@(Model.CurrentPage - 1)" 
                       asp-route-searchQuery="@Model.SearchQuery"
                       asp-route-filterStatus="@Model.FilterStatus"><i class="bi bi-chevron-left"></i></a>
                </li>
                
                @{ int _mP = 10; int _sP = Math.Max(1, Model.CurrentPage - _mP/2); int _eP = Math.Min(Model.TotalPages, _sP + _mP - 1); if(_eP - _sP + 1 < _mP){_sP = Math.Max(1, _eP - _mP + 1);} }
                        @for (int i = _sP; i <= _eP; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-page="@i" 
                           asp-route-searchQuery="@Model.SearchQuery"
                           asp-route-filterStatus="@Model.FilterStatus">@i</a>
                    </li>
                }

                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" 
                       asp-route-page="@(Model.CurrentPage + 1)" 
                       asp-route-searchQuery="@Model.SearchQuery"
                       asp-route-filterStatus="@Model.FilterStatus"><i class="bi bi-chevron-right"></i></a>
                </li>
            </ul>
        </nav>
    }
</main>
