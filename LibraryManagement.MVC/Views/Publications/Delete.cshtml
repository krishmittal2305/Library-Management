@model LibraryManagement.MVC.Models.Publication

@{
    var title = Model.Type == LibraryManagement.MVC.Models.PublicationType.Magazine ? "Magazine" : (Model.Type == LibraryManagement.MVC.Models.PublicationType.Newspaper ? "Newspaper" : "Publication");
    ViewData["Title"] = $"Delete {title}";
}

<div class="page-header">
    <div class="container">
        <h1><i class="bi bi-trash-fill me-2"></i>Delete @title</h1>
        <p class="text-danger">Are you sure you want to delete this @title.ToLower()?</p>
    </div>
</div>

<main class="container page-wrapper">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" asp-route-type="@Model.Type" class="text-primary text-decoration-none">@title List</a></li>
            <li class="breadcrumb-item active" aria-current="page">Delete @title</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm border border-danger">
                <div class="card-header bg-danger bg-opacity-10 d-flex align-items-center gap-2 pt-3 pb-2 border-bottom-0">
                    <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                    <span class="fw-bold text-danger">Confirm Deletion</span>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Title:</dt>
                        <dd class="col-sm-8 fw-bold">@Model.Title</dd>
                        
                        <dt class="col-sm-4 text-muted">Publisher:</dt>
                        <dd class="col-sm-8">@Model.Publisher</dd>

                        <dt class="col-sm-4 text-muted">Date:</dt>
                        <dd class="col-sm-8">@Model.PublishedDate.ToShortDateString()</dd>
                    </dl>

                    <hr class="my-4" />

                    <form asp-action="Delete" asp-route-id="@Model.Id">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex gap-2 justify-content-end">
                            <a asp-action="Index" asp-route-type="@Model.Type" class="btn btn-light border px-4">Cancel</a>
                            <button type="submit" class="btn btn-danger px-4">
                                <i class="bi bi-trash me-1"></i> Delete
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</main>
