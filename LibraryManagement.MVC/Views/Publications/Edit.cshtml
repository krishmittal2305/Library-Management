@model LibraryManagement.MVC.Models.Publication

@{
    var title = Model.Type == LibraryManagement.MVC.Models.PublicationType.Magazine ? "Magazine" : (Model.Type == LibraryManagement.MVC.Models.PublicationType.Newspaper ? "Newspaper" : "Publication");
    ViewData["Title"] = $"Edit {title}";
}

<div class="page-header">
    <div class="container">
        <h1><i class="bi bi-pencil-square me-2"></i>Edit @title</h1>
        <p>Update the details of the @title.ToLower().</p>
    </div>
</div>

<main class="container page-wrapper">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" asp-route-type="@Model.Type" class="text-primary text-decoration-none">@title List</a></li>
            <li class="breadcrumb-item active" aria-current="page">Edit @title</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm border">
                <div class="card-header bg-white d-flex align-items-center gap-2 pt-3 pb-2">
                    <i class="bi bi-pencil text-primary fs-5"></i>
                    <span class="fw-bold">@title Information</span>
                </div>
                <div class="card-body">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="Type" />

                        <div class="mb-4">
                            <label asp-for="Title" class="form-label fw-bold">Title <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="form-control" required />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Publisher" class="form-label fw-bold">Publisher <span class="text-danger">*</span></label>
                            <input asp-for="Publisher" class="form-control" required />
                            <span asp-validation-for="Publisher" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="PublishedDate" class="form-label fw-bold">Published Date <span class="text-danger">*</span></label>
                            <input asp-for="PublishedDate" class="form-control" required />
                            <span asp-validation-for="PublishedDate" class="text-danger small"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="IsAvailable" class="form-check-input" type="checkbox" />
                            <label class="form-check-label fw-bold" asp-for="IsAvailable">Is Available</label>
                        </div>

                        <div class="d-flex gap-2 justify-content-end mt-5">
                            <a asp-action="Index" asp-route-type="@Model.Type" class="btn btn-light border px-4">Cancel</a>
                            <button type="submit" class="btn btn-success px-4">
                                <i class="bi bi-check-circle me-1"></i> Update @title
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</main>
