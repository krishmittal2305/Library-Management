@model IEnumerable<LibraryManagement.MVC.Models.Student>
@{ Layout = "_PrintLayout"; }
<table>
    <thead><tr><th>ID</th><th>Enrollment No</th><th>Name</th><th>Email</th><th>Phone</th><th>Department</th><th>Semester</th></tr></thead>
    <tbody>@foreach (var item in Model) { <tr><td>@item.Id</td><td>@item.EnrollmentNo</td><td><strong>@item.Name</strong></td><td>@item.Email</td><td>@item.Phone</td><td>@item.Department</td><td>@item.Semester</td></tr> }</tbody>
</table>
<div class="mt-3 text-end fw-bold">Total Records: @Model.Count()</div>
