@model IEnumerable<LibraryManagement.MVC.Models.Librarian>
@{ Layout = "_PrintLayout"; }
<table>
    <thead><tr><th>ID</th><th>Employee ID</th><th>Name</th><th>Email</th><th>Phone</th><th>Shift</th></tr></thead>
    <tbody>@foreach (var item in Model) { <tr><td>@item.Id</td><td>@item.EmployeeId</td><td><strong>@item.Name</strong></td><td>@item.Email</td><td>@item.Phone</td><td>@item.Shift</td></tr> }</tbody>
</table>
<div class="mt-3 text-end fw-bold">Total Records: @Model.Count()</div>
