@model IEnumerable<LibraryManagement.MVC.Models.Fine>
@{ Layout = "_PrintLayout"; }
<table>
    <thead><tr><th>Fine ID</th><th>Student Name</th><th>Borrow ID</th><th>Amount</th><th>Reason</th><th>Generated Date</th><th>Status</th></tr></thead>
    <tbody>@foreach (var item in Model) { <tr><td>@item.FineId</td><td><strong>@item.Student?.Name</strong></td><td>@item.BorrowId</td><td>₹@item.Amount.ToString("0.00")</td><td>@item.Reason</td><td>@item.GeneratedDate.ToShortDateString()</td><td>@item.Status</td></tr> }</tbody>
</table>
<div class="mt-3 text-end fw-bold">Total Records: @Model.Count()</div>
