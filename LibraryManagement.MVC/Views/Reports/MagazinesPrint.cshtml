@model IEnumerable<LibraryManagement.MVC.Models.Magazine>
@{ Layout = "_PrintLayout"; }
<table>
    <thead><tr><th>ID</th><th>Title</th><th>Publisher</th><th>Category</th><th>Language</th><th>Published Date</th><th>Status</th></tr></thead>
    <tbody>@foreach (var item in Model) { <tr><td>@item.MagazineId</td><td><strong>@item.Title</strong></td><td>@item.Publisher</td><td>@item.Category</td><td>@item.Language</td><td>@item.PublishedDate.ToShortDateString()</td><td>@(item.Availability ? "Available" : "Issued")</td></tr> }</tbody>
</table>
<div class="mt-3 text-end fw-bold">Total Records: @Model.Count()</div>
