@model IEnumerable<LibraryManagement.MVC.Models.Book>

@{
    Layout = "_PrintLayout";
}

<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Title</th>
            <th>Author</th>
            <th>ISBN</th>
            <th>Category</th>
            <th>Total Copies</th>
            <th>Available Copies</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td><strong>@item.Title</strong></td>
                <td>@item.Author</td>
                <td>@item.ISBN</td>
                <td>@item.Category</td>
                <td>@item.TotalCopies</td>
                <td>@item.AvailableCopies</td>
            </tr>
        }
    </tbody>
</table>
<div class="mt-3 text-end fw-bold">
    Total Records: @Model.Count()
</div>
