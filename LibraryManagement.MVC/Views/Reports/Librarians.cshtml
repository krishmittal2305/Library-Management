@model LibraryManagement.MVC.ViewModels.ReportViewModel<LibraryManagement.MVC.Models.Librarian>

@{ ViewData["Title"] = Model.ReportTitle; }

<div class="page-header"><div class="container d-flex justify-content-between align-items-center"><div><h1><i class="bi bi-person-badge me-2"></i>@Model.ReportTitle</h1><p>Data report and export tools.</p></div><div><a asp-action="@Model.ExportExcelAction" asp-route-searchQuery="@Model.SearchQuery" class="btn btn-success me-2 fw-bold"><i class="bi bi-file-earmark-spreadsheet-fill me-1"></i> Excel (CSV)</a><a asp-action="@Model.ExportPdfAction" asp-route-searchQuery="@Model.SearchQuery" target="_blank" class="btn btn-danger fw-bold"><i class="bi bi-file-earmark-pdf-fill me-1"></i> Export PDF</a></div></div></div>

<main class="container page-wrapper">
    <div class="card mb-4 border-0 shadow-sm"><div class="card-body p-3"><form method="get" asp-action="Librarians" class="row g-3 align-items-center"><div class="col-md-10"><input type="text" name="searchQuery" value="@Model.SearchQuery" class="form-control bg-light" placeholder="Search report data..." /></div><div class="col-md-2 d-grid"><button type="submit" class="btn btn-primary"><i class="bi bi-search me-1"></i> Search</button></div></form></div></div>

    <div class="table-responsive table-wrapper border shadow-sm mb-5 bg-white">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>ID</th><th>Emp ID</th><th>Name</th><th>Email</th><th>Phone</th><th>Shift</th></tr></thead>
            <tbody>
                @if (!Model.Items.Any()){<tr><td colspan="6" class="text-center py-5 text-muted fw-bold">No records found.</td></tr>}
                else{foreach (var item in Model.Items){<tr><td class="text-muted">@item.Id</td><td><span class="badge bg-secondary">@item.EmployeeId</span></td><td class="fw-bold">@item.Name</td><td>@item.Email</td><td>@item.Phone</td><td>@item.Shift</td></tr>}}
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1) { <nav class="d-flex justify-content-between align-items-center"><span class="text-muted small">Showing Page @Model.CurrentPage of @Model.TotalPages</span><ul class="pagination pagination-sm mb-0"><li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")"><a class="page-link" asp-action="Librarians" asp-route-page="@(Model.CurrentPage - 1)" asp-route-searchQuery="@Model.SearchQuery"><i class="bi bi-chevron-left"></i></a></li>@{ int _mP = 10; int _sP = Math.Max(1, Model.CurrentPage - _mP/2); int _eP = Math.Min(Model.TotalPages, _sP + _mP - 1); if(_eP - _sP + 1 < _mP){_sP = Math.Max(1, _eP - _mP + 1);} }
                        @for (int i = _sP; i <= _eP; i++){<li class="page-item @(i == Model.CurrentPage ? "active" : "")"><a class="page-link" asp-action="Librarians" asp-route-page="@i" asp-route-searchQuery="@Model.SearchQuery">@i</a></li>}<li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")"><a class="page-link" asp-action="Librarians" asp-route-page="@(Model.CurrentPage + 1)" asp-route-searchQuery="@Model.SearchQuery"><i class="bi bi-chevron-right"></i></a></li></ul></nav> }
</main>
